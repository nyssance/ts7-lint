{
  "name": "@nyssance/ts7-lint",
  "version": "0.1.3",
  "description": "The TypeScript 7 modern-syntax rules for bun lint, run as their own check next to bun lint",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyssance/ts7-lint.git"
  },
  "homepage": "https://github.com/nyssance/ts7-lint#readme",
  "keywords": ["bun", "lint", "typescript", "modern-syntax", "esnext"],
  "type": "module",
  "bin": {
    "ts7-lint": "src/index.ts"
  },
  "files": ["src/index.ts", "rules.toml", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bun lint",
    "format": "bun fmt",
    "ts7-lint": "bun src/index.ts",
    "check": "bun run typecheck && bun run lint && bun run ts7-lint && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
